# ========================================================
# KnowledgePilot Environment Configuration Template
# Copy this file to .env in local development.
# NEVER commit .env to version control.
# ========================================================

# Server Runtime & Port Configuration
# Zoho Catalyst AppSail injects X_ZOHO_CATALYST_LISTEN_PORT in production
NODE_ENV=development
PORT=3001
X_ZOHO_CATALYST_LISTEN_PORT=

# Groq LLM Configuration (Exclusive MVP LLM Provider)
# Obtain key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REQUEST_TIMEOUT_MS=45000
GROQ_MAX_RETRIES=3

# Dedicated Vector Embedding Configuration
# Options: 'local' (uses in-process @xenova/transformers all-MiniLM-L6-v2, 100% free) or 'cloud'
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_DATABASE=knowledgepilot
MYSQL_CONNECTION_LIMIT=10
MYSQL_SSL=false

# Client Configuration (Used by Vite dev server)
VITE_API_URL=http://localhost:3001
